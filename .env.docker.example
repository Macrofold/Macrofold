# Overlay for trusted local development. Copy to .env.docker; keep .env for simulation.
PLATFORM_MODE=local
EXECUTION_PROVIDER=docker
ORCHESTRATION_BACKEND=poller
APP_ORIGIN=http://localhost:3210
DOCKER_RUNTIME_IMAGE=platform-runtime:0.1.0
# Start with one native container; raise only within your Docker CPU/memory allocation.
GLOBAL_CONCURRENT_RUN_LIMIT=1
# Deliberately free local compute accounting. Model usage still consumes the run budget.
COMPUTE_MICRO_USD_PER_MINUTE=0
# Set true only after selecting your provider/model and approving your own inference spending.
ALLOW_PAID_EXECUTION=false
# Set reviewed enabled model IDs/rates as documented in the Docker development guide.
MODEL_CATALOG_JSON=[]
# Managed model keys may be inherited from .env; BYOK is encrypted through dashboard Connections.
