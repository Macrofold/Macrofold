# Local development only. Production uses separately generated secrets and explicit service credentials.
PRODUCT_NAME=Platform
APP_ORIGIN=http://localhost:3210
PLATFORM_MODE=local
EXECUTION_PROVIDER=simulator
ALLOW_PAID_EXECUTION=false
DATABASE_URL=postgres://platform_app:local-app-only@127.0.0.1:55432/platform
MIGRATION_DATABASE_URL=postgres://platform_owner:local-development-only@127.0.0.1:55432/platform
AUTH_DATABASE_URL=postgres://platform_app:local-app-only@127.0.0.1:55432/platform
DATABASE_RUNTIME_ROLE=platform_app
AUTH_SECRET=local-only-change-before-deploy-32-bytes
VAULT_KEY=local-vault-only-change-before-deploy
OPERATOR_EMAILS=demo@example.test
# Local standalone Docker acceptance: LOCAL_SMTP_HOST=mail and LOCAL_SMTP_PORT=1025.

# Production: configure in your hosting provider. Never check real credentials into Git.
# PLATFORM_MODE=production
# EXECUTION_PROVIDER=vercel
# APP_ORIGIN=https://agents.example.com
# EMAIL_FROM=Platform <hello@example.com>
# RESEND_API_KEY=
# CRON_SECRET=
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# RUNTIME_IMAGE=agent-runtime@sha256:REPLACE_WITH_READY_VCR_DIGEST
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# VERCEL_TOKEN=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# COMPOSIO_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_PRICE_ID=
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# GITHUB_WEBHOOK_SECRET=
# COMPOSIO_AUTH_CONFIGS_JSON={"gmail":"ac_REPLACE"}
# COMPOSIO_TOOLKIT_VERSIONS_JSON={"gmail":"PIN_TESTED_VERSION"}
# COMPOSIO_MICRO_USD_PER_CALL=3000
# BRAVE_SEARCH_API_KEY=
# BRAVE_SEARCH_MICRO_USD_PER_CALL=6000
# PRO_MONTHLY_PRICE_MICRO_USD=29000000
# MCP_STDIO_CATALOG_JSON=See docs/19-tools-and-security.md; the image includes the reviewed filesystem server by default.
# COMPOSIO_CALLBACK_VERIFICATION_ENABLED=true
# MCP_OAUTH_CLIENTS_JSON={"https://your-mcp-server.example":{"client_id":"pre-registered-client","client_secret":"optional-secret"}}
# PRO_INCLUDED_CREDIT_MICRO_USD=10000000
# SANDBOX_EGRESS_DOMAINS=registry.npmjs.org,pypi.org,files.pythonhosted.org,github.com,api.github.com
# GITHUB_CLIENT_ID=Optional separate social-login OAuth application
# GITHUB_CLIENT_SECRET=
# MODEL_CATALOG_JSON=See docs/17-runtime-implementation.md for the rate-card schema.
# Optional vault rotation: keep VAULT_KEY for legacy values and retain all old keyring entries.
# VAULT_ACTIVE_KEY_ID=2026-09
# VAULT_KEYRING_JSON={"2026-09":"GENERATE_AT_LEAST_32_RANDOM_BYTES"}

# ORCHESTRATION_BACKEND=workflow (Vercel default) or poller (portable control plane)
# WORKER_CONCURRENCY=4
# GLOBAL_CONCURRENT_RUN_LIMIT=50
# RUN_ADMISSION_ENABLED=true
# PUBLIC_SIGNUP_ENABLED=true
# SUPPORT_EMAIL=Your real support address
# PRIVACY_URL=https://YOUR_DOMAIN/privacy-policy
# TERMS_URL=https://YOUR_DOMAIN/terms
# Optional metadata-only product analytics export. Disabled even when a token is present.
# POSTHOG_ENABLED=false
# POSTHOG_REGION=us
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_START_AT=2026-09-06T00:00:00Z
# POSTHOG_DAILY_EVENT_LIMIT=10000

# Scale: configure matching monthly USD Stripe price and restricted Portal tier switching.
# STRIPE_SCALE_PRICE_ID=price_from_your_stripe_account
# SCALE_MONTHLY_PRICE_MICRO_USD=199000000
# SCALE_INCLUDED_CREDIT_MICRO_USD=50000000
# Execution caps: Starter 2/1800s, Pro 10/3600s, Scale 50/7200s.
# Customers may lower caps through /v1/organization/execution-policy.
# New runs default to a 86400-second queue deadline; queue_timeout_seconds can shorten it.
