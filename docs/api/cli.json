  "selection_precedence": [
    "flags",
    "local link metadata",
    "explicit global default"
  ],
  "output_modes": [
    "interactive",
    "plain",
    "json",
    "jsonl"
  ],
  "stream": {
    "openapi_event_schema": "Event",
    "transport": "SSE",
    "rotation_seconds": 55,
    "cursor": "Last-Event-ID",
    "disconnect_cancels": false
  },
  "queue": {
    "opt_in_field": "queue_if_busy",
    "cli_chat_default": true,
    "max_pending_per_session": 10,
    "expiry_seconds": 86400,
    "budget_reserved_at_admission": true
  },
  "transfers": {
    "plan_expiry_seconds": 1800,
    "max_files": 1000,
    "max_bytes": 262144000,
    "max_file_bytes": 26214400,
    "implicit_upload": false,
    "default_delete": false,
    "symlink_transfer": false
  },
  "exit_codes": {
    "0": "success_or_accepted_detach",
    "1": "execution_or_persistence_failed",
    "2": "invalid_invocation_or_configuration",
    "3": "authentication_or_authorization",
    "4": "waiting_for_input",
    "5": "conflict",
    "6": "credit_or_quota",
    "7": "transport_unknown_remote_status",
    "8": "timeout",
    "130": "local_interrupt_or_cancel"
  },
