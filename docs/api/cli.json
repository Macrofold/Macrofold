  "scope_catalog": {
    "identity:read": "Inspect current principal and authorized organizations",
    "projects:read": "Read authorized projects/workspaces",
    "projects:write": "Manage authorized projects/workspaces",
    "files:read": "Read files, checkpoints and exports",
    "files:write": "Edit, transfer and restore files or synchronize Git",
    "runs:read": "Read agents, sessions, runs and events",
    "runs:write": "Configure agents/sessions, submit/input/cancel runs",
    "connections:read": "Inspect authorized connections and tools",
    "connections:write": "Create/authenticate/test/change connections and grants",
    "usage:read": "Read tenant request/usage/billing state",
    "billing:write": "Manage authorized checkout and billing portal",
    "keys:write": "Manage API keys within creator authority",
    "webhooks:read": "Inspect authorized webhooks",
    "webhooks:write": "Manage webhook subscriptions/deliveries",
    "offline_access": "Rotating refresh token",
    "organizations:read": "Read team membership",
    "organizations:write": "Manage organizations, roles and invitations",
    "projects:delete": "Schedule or cancel permanent project deletion (owner/admin only)"
  },
  "json_output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "schema_version": {
        "const": "1"
      },
      "command": {
        "type": "string"
      },
      "ok": {
        "type": "boolean"
      },
      "data": {},
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string",
            "description": "Recovery identity for a mutation whose response could not be confirmed; preserve it when retrying through the API or SDK."
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "exit_code": {
        "type": "integer",
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8,
          130
        ]
      }
    },
    "required": [
      "schema_version",
      "command",
      "ok",
      "exit_code"
    ],
    "additionalProperties": false,
    "oneOf": [
      {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "data"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      },
      {
        "properties": {
          "ok": {
            "const": false
          }
        },
        "required": [
          "error"
        ]
      }
    ]
  },
  "json_data_contract": "Command result uses the corresponding public API response or documented local result. run/chat use RunResult; detach uses RunAccepted. Binary files use explicit download paths when JSON mode is selected.",
  "scheduling": {
    "queue_timeout_seconds": {
      "default": 86400,
      "minimum": 1,
      "maximum": 86400
    },
    "attached_default": "interactive",
    "detached_default": "background",
    "flags": "--queue-timeout SECONDS --scheduling interactive|background",
    "visibility": "Human streams poll queued status every five seconds for elapsed wait, reason, deadline, held budget and cancellation command. JSON status exposes these fields via run show; no exact queue position or ETA."
  }
