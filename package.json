{
  "name": "hosted-agent-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @platform/web dev",
    "build": "pnpm --filter @platform/web build",
    "start": "pnpm --filter @platform/web start",
    "check": "pnpm sdk:build && tsc --noEmit",
    "test": "tsx scripts/test-domain.ts",
    "test:integration": "tsx scripts/test-domain.ts tests/integration",
    "test:e2e": "playwright test",
    "test:cli": "pnpm --filter @hosted-agents/cli build && vitest run tests/cli",
    "test:packages": "pnpm sdk:build && pnpm --filter @hosted-agents/cli build && tsx scripts/test-packages.ts",
    "test:native": "tsx scripts/test-native.ts",
    "build:runtime": "tsx scripts/build-runtime.ts",
    "setup": "tsx scripts/setup.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "doctor": "tsx scripts/doctor.ts",
    "cli": "tsx packages/cli/src/index.ts",
    "contracts": "openapi-typescript docs/api/openapi.json -o packages/contracts/api.d.ts && tsx scripts/generate-sdk.ts",
    "sdk:generate": "tsx scripts/generate-sdk.ts",
    "sdk:build": "pnpm --filter macrofold build",
    "test:domain": "tsx scripts/test-domain.ts",
    "test:coverage": "tsx scripts/test-domain.ts tests/unit tests/integration tests/git.test.ts tests/git-sync.test.ts --coverage",
    "test:mutation": "stryker run",
    "connectors:refresh": "tsx scripts/refresh-connector-catalog.ts",
    "test:load": "tsx scripts/test-domain.ts tests/load",
    "test:coverage:all": "tsx scripts/coverage/all.ts",
    "test:dashboard:isolated": "tsx scripts/test-dashboard.ts",
    "coverage:merge": "tsx scripts/coverage/merge.ts",
    "test:mutation:critical": "tsx scripts/test-mutation.ts",
    "test:live": "tsx scripts/test-live.ts",
    "docs:generate": "tsx scripts/docs/generate.ts",
    "docs:check": "tsx scripts/docs/generate.ts --check && python3 scripts/check-docs.py",
    "sdk:generate:all": "pnpm contracts && tsx scripts/sdk/generate.ts",
    "test:sdks": "tsx scripts/test-sdks.ts",
    "dev:docker": "tsx scripts/docker-profile.ts dev",
    "worker:docker": "tsx scripts/docker-profile.ts worker",
    "doctor:docker": "tsx scripts/docker-profile.ts doctor",
    "test:journey:docker": "tsx scripts/test-docker-journey.ts",
    "test:journey:live": "tsx scripts/test-live-journey.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.261",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@better-auth/oauth-provider": "1.7.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@composio/core": "0.18.1",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@oclif/core": "^4.10.0",
    "@octokit/app": "^16.1.2",
    "@opencode-ai/sdk": "1.18.29",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@scalar/nextjs-api-reference": "^0.9.16",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.25.0",
    "@vercel/sandbox": "3.2.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "5.10.0",
    "diff": "^9.0.0",
    "dotenv": "^17.3.1",
    "ink": "^6.8.0",
    "ipaddr.js": "^2.5.0",
    "isomorphic-git": "1.41.9",
    "jose": "^6.2.12",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "nodemailer": "^10.0.0",
    "pg": "^8.16.0",
    "qrcode.react": "4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.0",
    "sonner": "^2.0.7",
    "stripe": "^20.4.0",
    "tailwind-merge": "^3.5.0",
    "tar": "^7.5.11",
    "undici": "^8.10.2",
    "uuid": "^13.0.0",
    "workflow": "4.8.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@bcoe/v8-coverage": "1.0.2",
    "@jridgewell/trace-mapping": "0.3.31",
    "@neon/config": "1.3.0",
    "@playwright/test": "^1.58.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/diff": "^8.0.0",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/istanbul-reports": "3.0.4",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "ast-v8-to-istanbul": "0.3.12",
    "esbuild": "0.28.1",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "license": "Apache-2.0"
}
