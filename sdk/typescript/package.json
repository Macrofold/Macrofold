{
  "name": "macrofold",
  "version": "0.1.0",
  "description": "Typed API client and durable event streaming for hosted agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./react.css": "./dist/react.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"for (const name of ['schema.d.ts','react.css']) require('node:fs').copyFileSync('src/'+name,'dist/'+name)\""
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
